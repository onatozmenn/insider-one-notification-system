APP_ENV=development
HTTP_ADDR=:8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notifications

# Compose builds DATABASE_URL from the POSTGRES_* values.
# For host-run binaries, set it to the dev port:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/notifications?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# The demo URL expires after seven days.
# Create your own at https://webhook.site and replace this value.
PROVIDER_BASE_URL=https://webhook.site/7ca283a1-c80c-42fe-b578-40775e908fea
PROVIDER_TIMEOUT=10s

WORKER_CONCURRENCY=50
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=1
MAX_ATTEMPTS=5

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
WS_ENABLED=true
