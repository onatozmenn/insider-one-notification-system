APP_ENV=development
HTTP_ADDR=:8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notifications

# Compose builds DATABASE_URL from the POSTGRES_* values.
# For host-run binaries, set it to the dev port:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/notifications?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Create your own URL at https://webhook.site and paste it here.
# The provider URL is public, so never use a shared mailbox for real data.
PROVIDER_BASE_URL=https://webhook.site/replace-with-your-uuid
PROVIDER_TIMEOUT=10s

WORKER_CONCURRENCY=50
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=1
MAX_ATTEMPTS=5

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
WS_ENABLED=true
